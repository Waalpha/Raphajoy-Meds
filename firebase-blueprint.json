{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Hotel inventory product, room, or service item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "unitType": { "type": "string" },
        "buyingPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "openingStock": { "type": "number" },
        "currentStock": { "type": "number" },
        "minStockLevel": { "type": "number" }
      },
      "required": ["id", "name", "categoryId", "sellingPrice"]
    },
    "Category": {
      "title": "Category",
      "description": "Product or room category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Sales transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" }
      },
      "required": ["id", "totalAmount"]
    }
  },
  "firestore": {
    "/businesses/{businessId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products inventory collection"
    },
    "/businesses/{businessId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Categories collection"
    },
    "/businesses/{businessId}/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Sales collection"
    }
  }
}
